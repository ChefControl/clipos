        "type": "grafana-azure-monitor-datasource",
        "uid": "azure-monitor"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "azure-monitor"
          },
          "queryType": "Azure Log Analytics",
          "hide": false,
          "azureLogAnalytics": {
            "mode": "raw",
            "query": "AppServiceConsoleLogs\n| where $__timeFilter(TimeGenerated)\n| extend app = extract(@\"/sites/clipos-([a-z]+)-\", 1, _ResourceId)\n| extend j = parse_json(extract(@\"(\\{.*\\})\", 1, ResultDescription))\n| extend level = iff(isnull(j), \"TEXT\", tostring(j.level)), msg = tostring(j.message), target = tostring(j.target), job_kind = tostring(j.spans[0].kind)\n| where app == \"worker\" and isnotempty(job_kind)\n| where msg == \"transcoded\"\n| project TimeGenerated, [\"transcode (x real time)\"] = todouble(trim_end(\"x\", tostring(j.speed)))\n| order by TimeGenerated asc",
            "resources": [
              "/subscriptions/$sub/resourceGroups/rg-clipos/providers/Microsoft.OperationalInsights/workspaces/log-clipos"
            ],
            "resultFormat": "time_series",
            "dashboardTime": false
          }
        },
        {
          "refId": "B",
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "azure-monitor"
          },
          "queryType": "Azure Log Analytics",
          "hide": false,
          "azureLogAnalytics": {
            "mode": "raw",
            "query": "AppServiceConsoleLogs\n| where $__timeFilter(TimeGenerated)\n| extend app = extract(@\"/sites/clipos-([a-z]+)-\", 1, _ResourceId)\n| extend j = parse_json(extract(@\"(\\{.*\\})\", 1, ResultDescription))\n| extend level = iff(isnull(j), \"TEXT\", tostring(j.level)), msg = tostring(j.message), target = tostring(j.target), job_kind = tostring(j.spans[0].kind)\n| where app == \"worker\" and isnotempty(job_kind)\n| where msg == \"analysed killfeed\" and toint(j.frames) > 0\n| project TimeGenerated, [\"analyse (s per frame)\"] = todouble(j.elapsed_ms) / 1000 / toint(j.frames)\n| order by TimeGenerated asc",
            "resources": [
              "/subscriptions/$sub/resourceGroups/rg-clipos/providers/Microsoft.OperationalInsights/workspaces/log-clipos"
            ],
            "resultFormat": "time_series",
            "dashboardTime": false
          }
        }
      ],
      "description": "Transcode speed as a multiple of real time (higher is faster, left axis), and killfeed analysis seconds per sampled frame (lower is faster, right axis). One point per job.",
