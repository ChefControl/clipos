          "queryType": "Azure Log Analytics",
          "hide": false,
          "azureLogAnalytics": {
            "mode": "raw",
            "query": "AppServiceHTTPLogs\n| where $__timeFilter(TimeGenerated)\n| where _ResourceId has \"/sites/clipos-api-\" and UserAgent != \"AlwaysOn\" and CsUriStem != \"/healthz\"\n| extend ms = toint(TimeTaken), status = toint(ScStatus)\n| extend path = replace_regex(CsUriStem, @\"[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}\", \"{id}\")\n| extend path = case(\n    path startswith \"/api/users/\", replace_regex(path, @\"^/api/users/[^/]+\", \"/api/users/{handle}\"),\n    path startswith \"/s/\", replace_regex(path, @\"^/s/[^/]+\", \"/s/{token}\"),\n    path startswith \"/assets/\", \"/assets/*\",\n    path startswith \"/api/\" or path startswith \"/internal/\", path,\n    \"pages\")\n| extend route = strcat(CsMethod, \" \", path)\n| summarize count() by bin(TimeGenerated, $__interval), route\n| order by TimeGenerated asc",
            "resources": [
              "/subscriptions/$sub/resourceGroups/rg-clipos/providers/Microsoft.OperationalInsights/workspaces/log-clipos"
            ],
            "resultFormat": "time_series",
            "dashboardTime": false
          }
        }
      ],
      "description": "Static files are one route (/assets/*); paths the SPA serves, or scanners ask for, are \"pages\".",
      "interval": "15m",
      "fieldConfig": {
