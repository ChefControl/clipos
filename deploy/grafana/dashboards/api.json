          "queryType": "Azure Log Analytics",
          "hide": false,
          "azureLogAnalytics": {
            "mode": "raw",
            "query": "AppServiceConsoleLogs\n| where $__timeFilter(TimeGenerated)\n| extend app = extract(@\"/sites/clipos-([a-z]+)-\", 1, _ResourceId)\n| extend j = parse_json(extract(@\"(\\{.*\\})\", 1, ResultDescription))\n| extend level = iff(isnull(j), \"TEXT\", tostring(j.level)), msg = tostring(j.message), target = tostring(j.target), job_kind = tostring(j.spans[0].kind)\n| where (app == \"api\" and msg == \"listening\") or (app == \"worker\" and msg == \"worker started\")\n| project TimeGenerated, app, version = substring(tostring(j.version), 0, 7)\n| order by TimeGenerated desc",
            "resources": [
              "/subscriptions/$sub/resourceGroups/rg-clipos/providers/Microsoft.OperationalInsights/workspaces/log-clipos"
            ],
            "resultFormat": "table",
            "dashboardTime": false
          }
        }
