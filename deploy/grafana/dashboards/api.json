            "uid": "azure-monitor"
          },
          "queryType": "Azure Log Analytics",
          "hide": false,
          "azureLogAnalytics": {
            "mode": "raw",
            "query": "AppServiceHTTPLogs\n| where $__timeFilter(TimeGenerated)\n| where _ResourceId has \"/sites/clipos-api-\" and UserAgent != \"AlwaysOn\" and CsUriStem != \"/healthz\"\n| extend ms = toint(TimeTaken), status = toint(ScStatus)\n| extend path = replace_regex(CsUriStem, @\"[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}\", \"{id}\")\n| extend path = case(\n    path startswith \"/api/users/\", replace_regex(path, @\"^/api/users/[^/]+\", \"/api/users/{handle}\"),\n    path startswith \"/s/\", replace_regex(path, @\"^/s/[^/]+\", \"/s/{token}\"),\n    path startswith \"/assets/\", \"/assets/*\",\n    path startswith \"/api/\" or path startswith \"/internal/\", path,\n    \"pages\")\n| extend route = strcat(CsMethod, \" \", path)\n| summarize requests = count(), [\"4xx\"] = countif(status between (400 .. 499)), [\"5xx\"] = countif(status >= 500),\n    p50 = percentile(ms, 50), p95 = percentile(ms, 95), max = max(ms), avg_bytes = avg(tolong(ScBytes)) by route\n| order by requests desc",
            "resources": [
              "/subscriptions/$sub/resourceGroups/rg-clipos/providers/Microsoft.OperationalInsights/workspaces/log-clipos"
            ],
            "resultFormat": "table",
            "dashboardTime": false
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
