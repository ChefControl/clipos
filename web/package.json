{
  "name": "clipos-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b tsconfig.json tsconfig.e2e.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "gen:api": "openapi-typescript openapi.json -o src/api/schema.d.ts",
    "e2e": "playwright test",
    "coverage": "rm -rf .nyc_output coverage && vitest run --coverage && COVERAGE=1 playwright test && node e2e/remap-coverage.mjs .nyc_output coverage/merged/e2e.json && cp coverage/unit/coverage-final.json coverage/merged/unit.json && pnpm coverage:report",
    "coverage:report": "nyc report --temp-dir coverage/merged --report-dir coverage --reporter text-summary --reporter html --reporter json-summary --check-coverage --lines 95"
  },
  "dependencies": {
    "@auth0/auth0-react": "^2.27.0",
    "@fontsource/martian-mono": "^5.3.0",
    "@fontsource/saira-semi-condensed": "^5.3.0",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-router": "^1.170.41",
    "media-chrome": "4.19.3",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-istanbul": "5.0.3",
    "@vitest/istanbul-lib-source-maps": "1.0.2",
    "istanbul-lib-coverage": "3.2.2",
    "nyc": "18.0.0",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vite-plugin-istanbul": "9.0.1",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22"
  }
}
