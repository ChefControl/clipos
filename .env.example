# Copy to .env for local development (`make api`, `make worker`, docker compose).
DATABASE_URL=postgres://clipos:clipos@localhost:5432/clipos
# `entra` uses your `az login` token instead of a password (to reach the Azure server).
DATABASE_AUTH=password
AUTH0_DOMAIN=spawnpoint.eu.auth0.com
AUTH0_AUDIENCE=http://localhost:8080/api
# Public SPA client ID of `clipos-web-dev`: tofu -chdir=infra/auth0 output -raw web_dev_client_id
AUTH0_CLIENT_ID=
# Blob Storage: Azurite's well-known development account (public, not a secret).
STORAGE_ACCOUNT=devstoreaccount1
STORAGE_BLOB_ENDPOINT=http://127.0.0.1:10000/devstoreaccount1
STORAGE_ACCOUNT_KEY=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==
# Always-invited admins (comma-separated): your Google email, so you can sign in and invite others.
ADMIN_EMAILS=
LOG_FORMAT=pretty
